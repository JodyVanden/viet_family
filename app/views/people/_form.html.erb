<%= form_with model: person, class: "space-y-5" do |f| %>
  <% if person.errors.any? %>
    <div class="rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700">
      <p class="font-medium"><%= pluralize(person.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc list-inside">
        <% person.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :gender, class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :gender, Person::GENDERS.map { |g| [ g.capitalize, g ] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :birth_date, "Born", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :birth_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
    <div>
      <%= f.label :death_date, "Died", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :death_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :birth_order, "Birth order among siblings", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :birth_order, min: 1, class: "mt-1 block w-40 rounded-md border-gray-300 shadow-sm" %>
    <p class="text-xs text-gray-500 mt-1">Used to rank seniority when exact birth dates are unknown.</p>
  </div>

  <div>
    <%= f.label :portrait, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1 flex items-center gap-4">
      <% if person.portrait.attached? %>
        <%= image_tag person.portrait, alt: person.name,
              class: "w-16 h-16 rounded-full object-cover border border-gray-200 shrink-0" %>
      <% end %>
      <%= f.file_field :portrait, accept: "image/png,image/jpeg,image/webp",
            class: "block w-full text-sm text-gray-600 " \
                   "file:mr-3 file:py-2 file:px-4 file:rounded-md file:border-0 " \
                   "file:bg-indigo-600 file:text-white file:font-medium file:cursor-pointer " \
                   "hover:file:bg-indigo-700" %>
    </div>
    <p class="text-xs text-gray-500 mt-1">PNG, JPEG, or WebP, up to 5 MB.</p>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", (person.persisted? ? person : people_path), class: "px-4 py-2 rounded-md bg-white border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
