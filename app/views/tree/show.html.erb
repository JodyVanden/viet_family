<div class="p-6">
  <div class="max-w-6xl mx-auto flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-gray-900">Family tree</h1>
    <div class="flex gap-3">
      <%= link_to "People", people_path, class: "px-4 py-2 rounded-md bg-white border border-gray-300 text-gray-700 hover:bg-gray-50" %>
      <%= link_to "Add person", new_person_path, class: "px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700" %>
    </div>
  </div>

  <% if @people.any? %>
    <p id="viewpoint-hint" class="max-w-6xl mx-auto text-sm text-gray-500 mb-2">
      Click anyone to see how they address everyone — the whole family stays visible; their blood line is highlighted.
    </p>
    <div
      class="border border-gray-200 rounded-lg bg-white overflow-hidden"
      style="height: 80vh;"
      data-controller="tree"
      data-tree-nodes-value="<%= tree_nodes_json(@people, @levels) %>"
      data-tree-parent-edges-value="<%= @parent_edges.to_json %>"
      data-tree-spouse-edges-value="<%= @spouse_edges.to_json %>"
      data-tree-terms-value="<%= @terms.to_json %>">
    </div>
  <% else %>
    <p class="text-gray-500">No people yet. <%= link_to "Add someone", new_person_path, class: "text-indigo-600" %>.</p>
  <% end %>
</div>
